diff --color -ruN USB_Host_Shield_2.0/avrpins.h USB_Host_Shield_2.0_patched/avrpins.h
--- libraries/USB_Host_Shield_2.0/avrpins.h
+++ libraries/USB_Host_Shield_2.0/avrpins.h
@@ -1934,11 +1934,11 @@
 MAKE_PIN(P3, 3); // RX0
 MAKE_PIN(P21, 21); // SDA
 MAKE_PIN(P22, 22); // SCL
-MAKE_PIN(P19, 19); // MISO
