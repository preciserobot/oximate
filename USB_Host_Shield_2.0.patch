+++ libraries/USB_Host_Shield_2.0/UsbCore.h
@@ -51,7 +51,7 @@
 #elif defined(ARDUINO_XIAO_ESP32S3)
 typedef MAX3421e<P44, P4> MAX3421E; // ESP32 XIAO boards
 #elif defined(ESP32)
-typedef MAX3421e<P5, P17> MAX3421E; // ESP32 boards
